{
  "name": "@necode-ai/plugin-documents",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --timeout 60000",
    "typecheck": "tsgo --noEmit"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./server": {
      "bun": "./src/server.ts",
      "node": "./dist/server.js",
      "default": "./src/server.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "skills"
  ],
  "necode": {
    "plugin": {
      "id": "documents",
      "name": "Documents",
      "description": "创建、读取和修订 Word 文档",
      "skills": [
        "./skills/"
      ]
    }
  },
  "dependencies": {
    "@opencode-ai/plugin": "workspace:*",
    "@necode-ai/plugin-artifacts": "workspace:*",
    "docx": "9.5.1",
    "markit-ai": "0.5.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
